# 100xAltcoin environment — copy to .env; the binary loads ./.env automatically
# (variables already set in the environment always win).

# --- CoinMarketCap ---
# Only /v1/cryptocurrency/listings/latest is used, which every CMC plan
# (including the free Basic tier) includes. /key/info is read for credit usage.
CMC_API_KEY=                          # required; leave empty only with CMC_BASE_URL pointing at cmd/fakecmc
CMC_BASE_URL=https://pro-api.coinmarketcap.com  # http://localhost:8181 for local dev with fakecmc
CMC_RPM=25                            # CMC request rate limit

# --- Poll schedule presets (PRESET) ---
#   free:     top 1000, fast 200, poll 15m / slow 60m  (~190 credits/day, fits the 10k Basic plan)
#   startup:  top 3000, fast 200, poll 2m  / slow 15m  (~2.1k credits/day) [default]
#   standard: top 5000, fast 500, poll 1m  / slow 10m  (~7.6k credits/day)
# Small caps (the 100x hunting ground) sit at CMC ranks ~800-3000, so startup
# or standard finds far more of them than free. Each knob below overrides the preset.
PRESET=startup
#TOP_N=3000
#FAST_N=200
#PAGE_SIZE=1000
#POLL_INTERVAL=2m
#SLOW_INTERVAL=15m

# --- x402 payments (USDC per call) ---
X402_ENABLED=true                     # false = every endpoint free (local development only)
X402_PAY_TO=                          # your 0x... address that receives USDC (required when enabled)
X402_NETWORK=eip155:84532             # eip155:84532 = Base Sepolia testnet, eip155:8453 = Base mainnet
X402_FACILITATOR_URL=https://x402.org/facilitator  # must support X402_NETWORK; use a mainnet facilitator for eip155:8453
#X402_FACILITATOR_AUTH=Bearer ...     # optional Authorization header for facilitators that need one

# Prices per call in USD (paid in USDC). Errors are never charged.
PRICE_GEMS=$0.02
PRICE_SCREEN=$0.01
PRICE_CLIMBERS=$0.01
PRICE_SECTORS=$0.01
PRICE_ASSET=$0.01
PRICE_DIGEST=$0.03

# --- HTTP ---
PORT=8080
LOG_LEVEL=info                        # debug, info, warn, error
#PUBLIC_URL=https://api.example.com   # public base URL for x402 resource URLs; Render's RENDER_EXTERNAL_URL is used automatically

# --- History (keeps /v1/climbers working across restarts) ---
HISTORY_FILE=./data/history.json.gz   # empty = memory only (climbers need 24h after every restart)
HISTORY_SAVE_EVERY=10m

# --- Freshness (defaults follow the preset's slow tier) ---
#STALE_AFTER=19m                      # older data gets a stale_data warning
#MAX_STALE=45m                        # older data is refused with 503 (never charged)
