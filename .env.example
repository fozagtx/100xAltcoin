# 100xAltcoin — copy to .env (loaded automatically; real env vars win)

# --- CoinMarketCap (only /listings/latest is used: works on every plan, free included) ---
CMC_API_KEY=
#CMC_BASE_URL=http://localhost:8181   # use the local fake: npm run fake-cmc

# --- x402 payments on Algorand ---
ALGORAND_NETWORK=mainnet
PAY_TO_ADDRESS=                       # your MainNet address (public address only); must be opted in
                                      # to USDC (ASA 31566704). Keep the same one all competition.
FACILITATOR_URL=https://facilitator.goplausible.xyz
PUBLIC_URL=                           # required: https://your-service.onrender.com (one domain only)
#X402_ENABLED=false                   # local dev only: serves every endpoint free
#ALGOD_URL=https://mainnet-api.algonode.cloud   # node used to check PAY_TO_ADDRESS is opted in to USDC

# Prices per call in USD, paid in USDC. Errors are never charged.
PRICE_GEMS=$0.02
PRICE_SCREEN=$0.01
PRICE_CLIMBERS=$0.01
PRICE_SECTORS=$0.01
PRICE_ASSET=$0.01
PRICE_DIGEST=$0.03

# --- Polling (PRESET=free|startup|standard; startup covers the top 3000 coins) ---
PRESET=startup
#TOP_N=3000
#POLL_INTERVAL=2m
#SLOW_INTERVAL=15m

# --- Server and history ---
PORT=3000
HISTORY_FILE=./data/history.json.gz   # keeps /v1/climbers working across restarts
HISTORY_DAYS=7                        # 1-7 days of hourly rank history (memory use grows with it; 4 fits a 512 MB host)
#HISTORY_SAVE_EVERY=30m

# --- Paying client (npm run pay -- <url>) ---
#AVM_MNEMONIC="25 words of a wallet holding USDC"
#MAX_USD=0.10
