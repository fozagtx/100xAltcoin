{
  "name": "100xaltcoin",
  "version": "1.0.0",
  "private": true,
  "description": "100xAltcoin: pay-per-call altcoin discovery API on Algorand x402. Finds small caps with 100x potential before they move.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fake-cmc": "tsx scripts/fake-cmc.ts",
    "pay": "tsx scripts/pay.ts",
    "check": "tsx scripts/check.ts",
    "wallet": "tsx scripts/wallet.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@x402/avm": "^2.28.0",
    "@x402/core": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "@x402/hono": "^2.28.0",
    "algosdk": "^3.8.0",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
